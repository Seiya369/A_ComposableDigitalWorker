@@ -0,0 +1,100 @@
+// @vitest-environment jsdom
+/** Additive workspace slots across contributor/owner installation and disposal. */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { cleanup, fireEvent, waitFor } from '@testing-library/react'
+import type { Context } from '@deepseek-ai/cordis'
+import type { WorkspaceId } from '@deepseek-ai/dsh-api-workspace-controller/client'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { PropsRenderSlots, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import { SlotTestRuntime, usePinnedBrowserLanguages } from '@deepseek-ai/dsh-client-test-runtime'
+import { LocaleRuntime } from '@deepseek-ai/dsh-client-locale/client'
+import { apply, inject } from '@deepseek-ai/dsh-client-ui-workspace/client'
+
+usePinnedBrowserLanguages('zh-CN')
+let runtime: SlotTestRuntime
+beforeEach(async () => {
+  localStorage.clear()
+  runtime = await SlotTestRuntime.create()
+  runtime.ctx.provide('shortcuts', { register: () => () => {}, catalog: createSnapshotStore([]) })
+  runtime.ctx.provide('layout', { selectPanel: vi.fn(), beginNavigation: () => new AbortController().signal })
+  runtime.releaseWorkspaceSource()
+  runtime.remote.provideNamespaces({ directoryPicker: {} })
+  const locale = new LocaleRuntime(runtime.ctx)
+  runtime.ctx.provide('locale', locale)
+  runtime.slots.installLocale(locale)
+  await runtime.workspaces.update((draft) => {
+    draft.items = ['alpha', 'beta'].map(title => ({
+      workspaceId: title as WorkspaceId, title, path: `/w/${title}`, sessionIds: [],
+      createdAt: '2026-01-01T00:00:00.000Z', updatedAt: '2026-01-01T00:00:00.000Z',
+    }))
+  })
+  await runtime.root.declare({ 'sidebar.workspaces': { kind: 'single', scope: 'root' } } as never, Frame as never)
+})
+afterEach(async () => { cleanup(); await runtime.dispose() })
+
+function Frame({ renderSlot }: PropsRenderSlots<'sidebar.workspaces'>) {
+  return <>{renderSlot('sidebar.workspaces', { wide: true, expandSidebar: () => {} })}</>
+}
+
+function extension(label: string, order: number, invoke = vi.fn()) {
+  return {
+    inject: ['slots'],
+    apply(ctx: Context) {
+      ctx.slots.inject('sidebar.workspaces.header.action', () => ctx.slots.register({
+        name: 'sidebar.workspaces.header.action', id: label, order,
+      }, () => <button>{label}</button>))
+      ctx.slots.inject('sidebar.workspaces.menu.action', () => ctx.slots.register({
+        name: 'sidebar.workspaces.menu.action', id: label, order,
+      }, ({ workspaceId, onClose }: PropsRuntime<'sidebar.workspaces.menu.action'>) =>
+        <button role="menuitem" onClick={() => { onClose(); invoke(workspaceId) }}>{label}</button>))
+    },
+  }
+}
+
+describe('additive workspace extensions', () => {
+  it('preserves native menus without contributors; late contributions receive the selected workspace and disappear on unload', async () => {
+    await runtime.mount({ inject: [...inject], apply })
+    const view = runtime.renderRoot()
+    const open = (title: string) => fireEvent.click(view.getByLabelText(`工作区“${title}”的操作`))
+    const names = () => view.getAllByRole('menuitem', { hidden: true }).map(item => item.textContent)
+    open('alpha')
+    expect(names()).toEqual(['重命名', '删除工作区'])
+    fireEvent.keyDown(document, { key: 'Escape' })
+
+    const invoke = vi.fn()
+    const second = await runtime.mount(extension('Second extension', 20, invoke))
+    const first = await runtime.mount(extension('First extension', 10))
+    expect(view.getAllByRole('button').filter(button => /extension/.test(button.textContent ?? '')).map(button => button.textContent))
+      .toEqual(['First extension', 'Second extension'])
+    for (const title of ['alpha', 'beta']) {
+      open(title)
+      expect(names()).toEqual(['重命名', '删除工作区', 'First extension', 'Second extension'])
+      fireEvent.click(view.getByRole('menuitem', { name: 'Second extension', hidden: true }))
+      expect(invoke).toHaveBeenLastCalledWith(title)
+      await waitFor(() => { expect(view.queryByRole('menu', { hidden: true })).toBeNull() })
+    }
+    open('alpha')
+    await first.dispose()
+    await second.dispose()
+    expect(names()).toEqual(['重命名', '删除工作区'])
+    expect(view.queryByText('Second extension')).toBeNull()
+    fireEvent.click(view.getByRole('menuitem', { name: '重命名', hidden: true }))
+    expect(await view.findByLabelText('工作区名称')).toBeTruthy()
+  })
+
