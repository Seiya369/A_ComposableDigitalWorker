    "src",
    "third_party/llm-wiki/LICENSE",
    "third_party/llm-wiki/README.md",
    "third_party/llm-wiki/UPSTREAM.json",
    "third_party/llm-wiki/package.json",
    "third_party/llm-wiki/package-lock.json",
    "third_party/llm-wiki/engine.ts",
    "third_party/llm-wiki/adapters",
    "third_party/llm-wiki/upstream",
    "third_party/llm-wiki/generated",
    "third_party/llm-wiki/web",
    "third_party/llm-wiki/dependency-licenses",
    "build-support/dependencies.lock.json",
    "skills",
    "cordis.patch.yml",
    "integration/README.md",
    "integration/THIRD_PARTY_NOTICES.md",
    "integration/check-host.mjs",
    "integration/harness-baseline.mjs",
    "scripts/plugin.mjs",
    "scripts/purge-profile.mjs",
    "scripts/build.mjs",
    "scripts/build-llm-wiki.mjs",
    "package-lock.json",
    "docs/architecture/graph-horses.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "LICENSES.md",
    "docs/architecture/project-delivery-review.md",
    "docs/architecture/native-capabilities.md",
    "docs/architecture/team-knowledge.md",
    "docs/architecture/employee-knowledge-policy.md",
    "GLOSSARY.md",
    "docs/architecture/employee-settings-refresh.md",
    "docs/architecture/shared-llm-wiki.md",
    "docs/architecture/incremental-knowledge.md",
    "docs/architecture/object-settings-transfer.md",
    "docs/architecture/workflow-editor.md",
    "docs/architecture/software-role-skills.md",
    "docs/architecture/project-entry-current.md",
    "docs/architecture/library-order.md",
    "docs/architecture/conversation-workflow.md",
    "docs/architecture/host-locale.md",
    "docs/decisions/002-workflow-library-references.md",
    "AGENTS.md",
    "docs/decisions/001-official-plugin-boundary.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.1-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "scripts": {
    "setup": "node scripts/link-harness.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node scripts/start-harness.mjs",
    "service:start": "node scripts/service.mjs start",
    "service:status": "node scripts/service.mjs status",
    "service:stop": "node scripts/service.mjs stop",
    "plugin:install": "node scripts/plugin.mjs install",
    "plugin:uninstall": "node scripts/plugin.mjs uninstall",
    "plugin:purge": "node scripts/plugin.mjs purge",
    "test:lifecycle": "node tests/plugin-lifecycle.mjs",
    "service:open": "node scripts/service.mjs open",
    "test:performance": "tsx scripts/performance-audit.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.28.2",
    "react": "18.3.1",
