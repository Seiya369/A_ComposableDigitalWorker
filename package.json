{
  "name": "dsh-plugin-composable-workforce",
  "version": "0.4.0",
  "description": "Composable digital employees, project memory, and reviewed delivery for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/harness/host.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/harness/host.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "skills",
    "cordis.patch.yml",
    "integration/README.md",
    "integration/THIRD_PARTY_NOTICES.md",
    "integration/check-host.mjs",
    "integration/harness-baseline.mjs",
    "scripts/plugin.mjs",
    "scripts/purge-profile.mjs",
    "docs/architecture/graph-horses.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "docs/architecture/project-workbench.md",
    "docs/architecture/native-capabilities.md",
    "docs/architecture/team-knowledge.md",
    "docs/architecture/employee-knowledge-policy.md",
    "GLOSSARY.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": "0.2.1-alpha.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "scripts": {
    "setup": "node scripts/link-harness.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node scripts/start-harness.mjs",
    "service:start": "node scripts/service.mjs start",
    "service:status": "node scripts/service.mjs status",
    "service:stop": "node scripts/service.mjs stop",
    "plugin:install": "node scripts/plugin.mjs install",
    "plugin:uninstall": "node scripts/plugin.mjs uninstall",
    "plugin:purge": "node scripts/plugin.mjs purge",
    "test:lifecycle": "node tests/plugin-lifecycle.mjs",
    "service:open": "node scripts/service.mjs open"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "tiktoken": "1.0.22"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-skill": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-workspace": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tool-todo": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tool-web": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tool-ask-user": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tool-present": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-token-meter": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-alpha.2"
  }
}
